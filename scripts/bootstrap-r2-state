#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^(create|import|migrate)$ ]]; then
  echo "usage: $0 <create|import|migrate>" >&2
  exit 2
fi

repo_root=$(git rev-parse --show-toplevel)
root="$repo_root/terraform/bootstrap/r2-state"
local_state="$root/terraform.tfstate"
work_dir=

cleanup() {
  if [[ -n "$work_dir" ]]; then
    rm -rf -- "$work_dir"
  fi
}
trap cleanup EXIT

require_env() {
  local name
  for name in "$@"; do
    if [[ -z "${!name:-}" ]]; then
      echo "$name must be set" >&2
      exit 1
    fi
  done
}

prepare_local_work_dir() {
  if [[ -e "$local_state" ]]; then
    echo "$local_state already exists; refusing to overwrite bootstrap state" >&2
    exit 1
  fi

  work_dir=$(mktemp -d)

  cp \
    "$root/.terraform.lock.hcl" \
    "$root/main.tf" \
    "$root/outputs.tf" \
    "$root/provider.tf" \
    "$root/variables.tf" \
    "$root/versions.tf" \
    "$work_dir/"

  tofu -chdir="$work_dir" init -backend=false -lockfile=readonly
}

create_bucket() {
  require_env CLOUDFLARE_API_TOKEN TF_VAR_cloudflare_account_id
  prepare_local_work_dir

  tofu -chdir="$work_dir" apply -state="$local_state"
  chmod 600 "$local_state"

  echo "R2 bucket and bucket-scoped state token created with temporary local state."
  echo "Securely store the r2_access_key_id and r2_secret_access_key outputs, then run:"
  echo "  scripts/bootstrap-r2-state migrate"
}

import_bucket() {
  require_env CLOUDFLARE_API_TOKEN TF_VAR_cloudflare_account_id
  local account_id=${TF_VAR_cloudflare_account_id:-}
  prepare_local_work_dir

  tofu -chdir="$work_dir" import \
    -state="$local_state" \
    cloudflare_r2_bucket.state \
    "$account_id/zunoser-tofu-state/default"

  tofu -chdir="$work_dir" apply -state="$local_state"
  chmod 600 "$local_state"

  echo "Existing R2 bucket imported and its state token created."
  echo "Securely store the state token outputs, then run: scripts/bootstrap-r2-state migrate"
}

migrate_state() {
  if [[ ! -e "$local_state" ]]; then
    echo "$local_state does not exist; run the create phase first" >&2
    exit 1
  fi

  export AWS_ACCESS_KEY_ID
  AWS_ACCESS_KEY_ID=$(jq -er '.outputs.r2_access_key_id.value | strings | select(length > 0)' "$local_state")
  export AWS_SECRET_ACCESS_KEY
  AWS_SECRET_ACCESS_KEY=$(jq -er '.outputs.r2_secret_access_key.value | strings | select(length > 0)' "$local_state")
  export AWS_ENDPOINT_URL_S3
  AWS_ENDPOINT_URL_S3=$(jq -er '.outputs.s3_endpoint.value | strings | select(length > 0)' "$local_state")
  export AWS_EC2_METADATA_DISABLED=true

  tofu -chdir="$root" init -migrate-state -force-copy
  tofu -chdir="$root" state pull >/dev/null

  for state_file in "$local_state" "$local_state.backup"; do
    if [[ -e "$state_file" ]]; then
      chmod 600 "$state_file"
    fi
  done

  echo "Bootstrap state migrated to bootstrap/r2-state/terraform.tfstate in R2."
  echo "Securely archive any local terraform.tfstate backup before removing it."
}

case $1 in
  create) create_bucket ;;
  import) import_bucket ;;
  migrate) migrate_state ;;
esac
